{:paths   ["src/main" "resources"]

 :deps    {org.clojure/clojure                     {:mvn/version "1.12.4"}

           ;; Fulcro + RAD, with statecharts replacing UI state machines and dynamic routing
           com.fulcrologic/fulcro                  {:mvn/version "3.10.0-RC2"}
           com.fulcrologic/fulcro-rad              {:mvn/version "1.6.24"}
           com.fulcrologic/fulcro-rad-statecharts  {:mvn/version "0.1.5"}
           com.fulcrologic/statecharts             {:mvn/version "1.4.0-RC18"}
           com.fulcrologic/fulcro-i18n             {:mvn/version "1.1.2"}
           ;; statecharts needs promesa >= 11 (promesa.core/await!); pathom otherwise drags in 8.x
           funcool/promesa                         {:mvn/version "11.0.678"}

           ;; General extras
           com.widdindustries/cljc.java-time       {:mvn/version "0.1.21"}
           edn-query-language/eql                  {:mvn/version "2025.09.27"}
           com.fulcrologic/guardrails              {:mvn/version "1.3.2"}

           ;; Server
           mount/mount                             {:mvn/version "0.1.23"}
           com.wsscode/pathom                      {:mvn/version "2.4.0"}
           hiccup/hiccup                           {:mvn/version "2.0.0"}
           ring/ring-defaults                      {:mvn/version "0.7.0"}
           ring/ring-core                          {:mvn/version "1.15.3"}
           http-kit/http-kit                       {:mvn/version "2.8.1"}
           buddy/buddy-hashers                     {:mvn/version "2.0.167"} ; AUTH: password hashing
           com.datomic/local                       {:mvn/version "1.0.291"}
           com.datomic/client-cloud                {:mvn/version "1.0.131"}
           com.fulcrologic/fulcro-rad-datomic      {:mvn/version "1.5.6"}

           ;; Unified logging for server
           com.taoensso/timbre                     {:mvn/version "6.8.0"}
           org.slf4j/log4j-over-slf4j              {:mvn/version "2.0.17"} ; auto sends log4j to slf4j
           org.slf4j/jul-to-slf4j                  {:mvn/version "2.0.17"} ; auto sends java.util.logging to slf4j
           org.slf4j/jcl-over-slf4j                {:mvn/version "2.0.17"} ; auto-sends java.common.logging to slf4j
           com.fzakaria/slf4j-timbre               {:mvn/version "0.4.1"}} ; hooks slf4j to timbre

 :aliases {:test      {:extra-paths ["src/test"]
                       :extra-deps  {fulcrologic/fulcro-spec {:mvn/version "3.2.8"}}}

           :cljs      {:extra-deps {org.clojure/clojurescript              {:mvn/version "1.12.134"}
                                    thheller/shadow-cljs                   {:mvn/version "3.3.6"}
                                    binaryage/devtools                     {:mvn/version "1.0.7"}
                                    com.fulcrologic/fulcro-devtools-remote {:mvn/version "0.2.8"}
                                    com.fulcrologic/fulcro-inspect         {:mvn/version "1.0.5"}}}

           :run-tests {:main-opts  ["-m" "kaocha.runner"]
                       :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}}

           :dev       {:extra-paths ["src/dev"]
                       :extra-deps  {org.clojure/tools.namespace {:mvn/version "1.5.1"}
                                     expound/expound             {:mvn/version "0.9.0"}}}

           ;; clojure -T:build uber
           :build     {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.10"}}
                       :ns-default build}}}
